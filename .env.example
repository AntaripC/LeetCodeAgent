# Optional environment variables for development or test runners
# (Note: In the extension, user API keys are safely configured via the Extension Settings UI and stored in chrome.storage.local)

# Google Gemini API Key
VITE_GEMINI_API_KEY=

# OpenAI API Key
VITE_OPENAI_API_KEY=

# Custom / Ollama Base URL
VITE_CUSTOM_BASE_URL=http://localhost:11434/v1
