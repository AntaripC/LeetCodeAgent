{
  "name": "leetcode-ai-copilot",
  "version": "1.0.0",
  "description": "Multi-model AI Copilot for LeetCode browser extension",
  "homepage": "https://antaripc.github.io/LeetCodeAgent/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AntaripC/LeetCodeAgent.git"
  },
  "bugs": {
    "url": "https://github.com/AntaripC/LeetCodeAgent/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "server": "node server/local-backend.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "generate-icons": "node scripts/generate-icons.js",
    "package:release": "node scripts/package-release.mjs",
    "site:preview": "python3 -m http.server 5174 --directory website"
  },
  "keywords": [
    "leetcode",
    "chrome-extension",
    "ai",
    "gemini",
    "openai",
    "copilot",
    "algorithms"
  ],
  "author": "LeetCode AI Copilot Team",
  "license": "MIT",
  "dependencies": {
    "lucide-react": "^1.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/chrome": "^0.1.32",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^28.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^4.0.8"
  }
}
